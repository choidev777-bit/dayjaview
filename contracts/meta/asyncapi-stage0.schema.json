{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dayjaview.example/contracts/meta/asyncapi-stage0.schema.json",
  "title": "AsyncAPI 3.0 Stage 0 profile",
  "description": "Stage 0 계약이 사용하는 AsyncAPI 기능의 결정적 구조 profile",
  "type": "object",
  "additionalProperties": true,
  "required": ["asyncapi", "info", "servers", "channels", "operations", "components"],
  "properties": {
    "asyncapi": {"const": "3.0.0"},
    "info": {
      "type": "object",
      "required": ["title", "version"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "servers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["host", "protocol", "pathname"],
        "properties": {
          "host": {"type": "string", "minLength": 1},
          "protocol": {"const": "wss"},
          "pathname": {"const": "/v1/realtime"}
        }
      }
    },
    "channels": {
      "type": "object",
      "required": ["realtime"],
      "properties": {
        "realtime": {
          "type": "object",
          "required": ["address", "messages"],
          "properties": {
            "address": {"const": "/v1/realtime"},
            "messages": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"$ref": "#/$defs/reference"}
            }
          }
        }
      }
    },
    "operations": {
      "type": "object",
      "required": ["receiveClientMessages", "sendServerMessages"],
      "additionalProperties": {
        "type": "object",
        "required": ["action", "channel", "messages"],
        "properties": {
          "action": {"enum": ["send", "receive"]},
          "channel": {"$ref": "#/$defs/reference"},
          "messages": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/reference"}
          }
        }
      }
    },
    "components": {
      "type": "object",
      "required": ["messages"],
      "properties": {
        "messages": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["name", "payload"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "payload": {"$ref": "#/$defs/reference"},
              "examples": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["payload"],
                  "properties": {"payload": {}}
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": ["$ref"],
      "properties": {"$ref": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    }
  }
}
