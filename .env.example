# DAYJAVIEW 환경변수 예시
# 이 파일은 저장소에 커밋할 수 있습니다.
# 실제 비밀값은 복사한 .env.local 또는 secret manager에만 입력하세요.

# -----------------------------------------------------------------------------
# 애플리케이션
# -----------------------------------------------------------------------------
APP_ENV=local
APP_LOG_LEVEL=debug
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
# production: APP_BASE_URL=https://dayjaview.vercel.app
# production: API_BASE_URL=https://api.dayjaview.duckdns.org
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 브라우저에 포함되어도 되는 공개 설정만 VITE_ 접두사를 사용합니다.
# VITE_ 변수에는 비밀키를 절대 넣지 마세요.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000/v1/realtime
# production: VITE_API_BASE_URL=/api
# production: VITE_WS_BASE_URL=wss://api.dayjaview.duckdns.org/v1/realtime

# -----------------------------------------------------------------------------
# 키움 REST API
# 일반 개발·테스트는 fixture, 모의투자는 demo, 운영 시세는 real을 사용합니다.
# mode: fixture | demo | real
# 주문 endpoint는 구현하지 않고 조회·실시간 API만 허용합니다.
# -----------------------------------------------------------------------------
KIWOOM_MODE=fixture
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=

# -----------------------------------------------------------------------------
# 공식 기준정보 API
# -----------------------------------------------------------------------------
KRX_API_KEY=
OPENDART_API_KEY=

# DuckDNS API ingress
DUCKDNS_DOMAIN=dayjaview
DUCKDNS_TOKEN=

# -----------------------------------------------------------------------------
# NAVER API HUB 뉴스 검색
# 기존 NAVER Developers 키와 다른 NAVER API HUB 인증값입니다.
# -----------------------------------------------------------------------------
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# OpenAI API
# 일반 project API key만 있으면 됩니다. Project ID는 사용하지 않습니다.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=medium

# -----------------------------------------------------------------------------
# 인포스탁
# 테마 목록·상세는 API, Daily 특징 테마는 로그인 browser worker로 수집합니다.
# source mode: fixture | api
# daily source mode: fixture | browser
# -----------------------------------------------------------------------------
INFOSTOCK_SOURCE_MODE=fixture
INFOSTOCK_DAILY_SOURCE_MODE=fixture
INFOSTOCK_IMPORT_DIR=./data/infostock/import
INFOSTOCK_API_BASE_URL=https://api.infostock.co.kr:9081/web
INFOSTOCK_USERNAME=
INFOSTOCK_PASSWORD=
INFOSTOCK_SESSION_STATE_PATH=./.secrets/infostock-storage-state.enc

# -----------------------------------------------------------------------------
# PostgreSQL·Redis
# 아래 값은 로컬 Docker 개발용 기본값입니다.
# 운영 비밀번호를 재사용하지 마세요.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://dayjaview:dayjaview@localhost:5432/dayjaview
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# 객체 저장소
# 로컬에서는 S3 호환 저장소를 사용할 수 있습니다.
# -----------------------------------------------------------------------------
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=ap-northeast-2
OBJECT_STORAGE_BUCKET=dayjaview-local
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# -----------------------------------------------------------------------------
# 인증·암호화
# 최소 32바이트 이상의 서로 다른 무작위 값을 사용합니다.
# -----------------------------------------------------------------------------
AUTH_SECRET=
APPLICATION_ENCRYPTION_KEY=
# 관심 목록 커서 서명 키. DATABASE_URL을 쓰면(=인스턴스가 여럿일 수 있으면)
# 반드시 채워야 하고, 비어 있으면 API가 기동하지 않습니다.
SESSION_SIGNING_SECRET=

# Google 로그인에 사용합니다.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 쉼표로 구분한 verified Google email. 최초 OPERATOR bootstrap에만 사용하고 내부 권한은 Google sub로 고정합니다.
OPERATOR_BOOTSTRAP_GOOGLE_EMAILS=
